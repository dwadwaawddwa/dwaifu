<3 Devine le nombre : Gina en choisit un, Senpai cherche <3

club:
    Yuki-sama   : boss
    Gina-chan   : guesser
    Hikari-chan : reader
    Nana-chan   : judge
    Mio-chan    : writer
desu

secret = Gina
essai  = Hikari

ohayo
secret ← guess 1..100 onegai
write "J'ai un nombre entre 1 et 100. Devine !" onegai

repeat:
    essai ← read onegai
    if essai > secret:
        write "Trop grand !" onegai
    else if essai < secret:
        write "Trop petit !" onegai
    desu
until essai == secret

write "Bravo Senpai ! ♡" onegai
arigatou minna
oyasumi
